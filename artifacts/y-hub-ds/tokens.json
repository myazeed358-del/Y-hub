{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Visual tokens extracted from the Y-hub application. The system uses a warm paper canvas, deep navy navigation, teal learning actions, amber emphasis, Cairo for Arabic-first UI text, and Space Mono for equations and numeric readouts.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#faf7f0", "$description": "Warm paper canvas." },
      "foreground": { "$value": "#242a45", "$description": "Deep ink text." },
      "border": { "$value": "#e1dbd0" },
      "card": { "$value": "#fefdfb" },
      "cardForeground": { "$value": "#242a45" },
      "popover": { "$value": "#fefdfb" },
      "popoverForeground": { "$value": "#242a45" },
      "primary": { "$value": "#27a283", "$description": "Teal for progress, actions, and active learning." },
      "primaryForeground": { "$value": "#fefdfb" },
      "secondary": { "$value": "#eee9db" },
      "secondaryForeground": { "$value": "#242a45" },
      "muted": { "$value": "#eee9de" },
      "mutedForeground": { "$value": "#6f7485" },
      "accent": { "$value": "#f3ad55", "$description": "Amber for highlights and attention states." },
      "accentForeground": { "$value": "#1c243b" },
      "destructive": { "$value": "#dd3b36" },
      "destructiveForeground": { "$value": "#fefdfb" },
      "input": { "$value": "#d9d2c5" },
      "ring": { "$value": "#27a283" },
      "chart1": { "$value": "#27a283" },
      "chart2": { "$value": "#f3ad55" },
      "chart3": { "$value": "#405477" },
      "chart4": { "$value": "#db7255" },
      "chart5": { "$value": "#4f9eb5" },
      "sidebar": { "$value": "#1c243b", "$description": "Deep navy navigation surface." },
      "sidebarForeground": { "$value": "#f3ead7" },
      "sidebarBorder": { "$value": "#303953" },
      "sidebarPrimary": { "$value": "#27a283" },
      "sidebarPrimaryForeground": { "$value": "#1c243b" },
      "sidebarAccent": { "$value": "#303953" },
      "sidebarAccentForeground": { "$value": "#f3ead7" },
      "sidebarRing": { "$value": "#27a283" }
    },
    "dark": {
      "background": { "$value": "#121828" },
      "foreground": { "$value": "#f3ead7" },
      "border": { "$value": "#2c344d" },
      "card": { "$value": "#1c243b" },
      "cardForeground": { "$value": "#f3ead7" },
      "popover": { "$value": "#1c243b" },
      "popoverForeground": { "$value": "#f3ead7" },
      "primary": { "$value": "#2aaf91" },
      "primaryForeground": { "$value": "#121828" },
      "secondary": { "$value": "#252d45" },
      "secondaryForeground": { "$value": "#f3ead7" },
      "muted": { "$value": "#252d45" },
      "mutedForeground": { "$value": "#c5baa0" },
      "accent": { "$value": "#f3ad55" },
      "accentForeground": { "$value": "#121828" },
      "destructive": { "$value": "#e44f4a" },
      "destructiveForeground": { "$value": "#121828" },
      "input": { "$value": "#39435c" },
      "ring": { "$value": "#2aaf91" },
      "chart1": { "$value": "#2aaf91" },
      "chart2": { "$value": "#f3ad55" },
      "chart3": { "$value": "#6d8ab6" },
      "chart4": { "$value": "#e47c5b" },
      "chart5": { "$value": "#61b9d1" },
      "sidebar": { "$value": "#0d1220" },
      "sidebarForeground": { "$value": "#f3ead7" },
      "sidebarBorder": { "$value": "#252d45" },
      "sidebarPrimary": { "$value": "#2aaf91" },
      "sidebarPrimaryForeground": { "$value": "#0d1220" },
      "sidebarAccent": { "$value": "#252d45" },
      "sidebarAccentForeground": { "$value": "#f3ead7" },
      "sidebarRing": { "$value": "#2aaf91" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Cairo", "Noto Sans Arabic", "Inter", "sans-serif"],
        "$description": "Arabic-first UI and body face, with Latin fallbacks."
      },
      "serif": { "$value": ["Cairo", "Georgia", "serif"] },
      "mono": {
        "$value": ["Space Mono", "IBM Plex Mono", "Menlo", "monospace"],
        "$description": "Equations, percentages, parameters, and technical labels."
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "1rem",
      "$description": "Rounded, approachable learning surfaces; cards use a larger derived radius."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Quarter-rem rhythm used by the existing application."
    }
  }
}